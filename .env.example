# Copy this file to ".env" and fill in your values.

# Leave empty to use the local SQLite file (instance/energy.db).
# MySQL example:  mysql+pymysql://energy:energy@localhost:3306/energy
DATABASE_URL=

# Optional - without a key the rule-based coach is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SECRET_KEY=change-me
SEED_DEMO_DATA=1
