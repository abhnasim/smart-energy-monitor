# Copy this file to ".env" and fill in your values.

# Leave empty to use the local SQLite file (instance/energy.db).
# MySQL example:  mysql+pymysql://energy:energy@localhost:3306/energy
DATABASE_URL=

# Optional AI coach - without a key the rule-based coach is used.
# Option 1: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Option 2: Google Gemini (free tier, key from https://aistudio.google.com/apikey).
# If GEMINI_API_KEY is set, Gemini is used instead of OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

SECRET_KEY=change-me
SEED_DEMO_DATA=1
